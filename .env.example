# LoveBot environment variables. Copy to .env and fill in.

# HTTP server port for the QR pairing page and upload API
PORT=3000
# pino log level: trace, debug, info, warn, error
LOG_LEVEL=info
# Name the bot announces itself with (also used as the Baileys browser name)
BOT_NAME=LoveBot

# LLM provider: openai or openrouter
LLM_PROVIDER=openai

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (required when LLM_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-your-openrouter-key
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_SITE_URL=https://yourwebsite.com
