{
  "name": "lovebot",
  "version": "1.0.0",
  "description": "WhatsApp bot with AI integration using Baileys",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node -r ./crypto-polyfill.js dist/index.js",
    "dev": "node -r ./crypto-polyfill.js -r ts-node/register src/index.ts",
    "watch": "nodemon --exec node -r ./crypto-polyfill.js -r ts-node/register src/index.ts",
    "cli": "node -r ./crypto-polyfill.js -r ts-node/register/transpile-only src/cli.ts",
    "cli:local": "node -r ./crypto-polyfill.js -r ts-node/register/transpile-only src/cli.ts --local-only",
    "smoke:advice": "node -r ./crypto-polyfill.js -r ts-node/register/transpile-only scripts/smoke/advice.ts",
    "smoke:comprehensive": "node -r ./crypto-polyfill.js -r ts-node/register/transpile-only scripts/smoke/comprehensive.ts",
    "smoke:analyzer": "node -r ./crypto-polyfill.js -r ts-node/register/transpile-only scripts/smoke/analyzer.ts",
    "smoke:import": "node -r ./crypto-polyfill.js -r ts-node/register/transpile-only src/cli.ts --test-chat-import test_files/sample_chats.zip"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.5.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.2",
    "mime-types": "^2.1.35",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "openai": "^7.17.0",
    "pino": "^8.15.0",
    "pino-pretty": "^10.2.0",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.32.6",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.3",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
